# Runs as root before the files are copied: removes the previous version, so that
# no stale file stays behind (inside the plugin bundles or in the support folder).
for p in "/Library/Audio/Plug-Ins/Components/StudioRider.component" \
         "/Library/Audio/Plug-Ins/VST3/StudioRider.vst3" \
         "/Library/Application Support/StudioRider" \
         "/Applications/StudioRider" \
         "/Library/Audio/Plug-Ins/Components/StudioWire.component" \
         "/Library/Audio/Plug-Ins/VST3/StudioWire.vst3" \
         "/Library/Application Support/StudioWire" \
         "/Applications/StudioWire" \
         "/Library/Audio/Plug-Ins/Components/MixShare.component" \
         "/Library/Audio/Plug-Ins/VST3/MixShare.vst3"; do
    [[ -e "$p" ]] && rm -rf "$p"
done
# StudioWire = former name of StudioRider (same plugin codes): forget its installer receipt.
/usr/sbin/pkgutil --forget net.studiowire.pkg >/dev/null 2>&1 || true
exit 0
